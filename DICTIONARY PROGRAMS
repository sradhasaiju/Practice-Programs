#4.iterate over a dictionary using for loop and print the keys alone, 
#values alone and both keys and values. 
d={'a':10,'b':20,'c':30,'d':40,'e':50}
print('Keys:')
for i in d:
    print(i)
print("\nValues:")
for j in d.values():
    print(j)
print("\nKey and Values:")
for k,v in d.items():
    print(k,v)

#output
Keys:
a
b
c
d
e

Values:
10
20
30
40
50

Key and Values:
